# Template for Cloud Run runtime env. Copy to deploy/cloudrun/env.yaml
# (gitignored) and apply with:
#   gcloud run services update qurieus --region=us-central1 --env-vars-file=deploy/cloudrun/env.yaml
#
# NEXT_PUBLIC_* belong in cloudbuild.yaml substitutions, not here.

NODE_ENV=production
NEXTAUTH_URL=https://qurieus.com
NEXTAUTH_SECRET=your-secret
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/qurieus?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST/qurieus?sslmode=require
BACKEND_URL=http://127.0.0.1:8080
BACKEND_HEALTH_URL=http://127.0.0.1:8001
FRONTEND_URL=https://qurieus.com
