# Cloud Run runtime env (YAML). Copy to env.yaml and fill in values, then:
#   gcloud run services update qurieus \
#     --region=us-central1 \
#     --env-vars-file=deploy/cloudrun/env.yaml
#
# Do not set PORT. Cloud Run injects 8080.
# NEXT_PUBLIC_* must be Docker build args / Cloud Build substitutions, not these runtime vars.
# env.yaml is gitignored — never commit secrets.

NODE_ENV: production
ENVIRONMENT: production
DEBUG: "False"

NEXTAUTH_URL: https://qurieus.com
NEXTAUTH_SECRET: replace-with-a-long-random-secret
NEXTAUTH_ALLOW_EMAIL_ACCOUNT_LINKING: "true"
NEXT_PUBLIC_APP_URL: https://qurieus.com
FRONTEND_URL: https://qurieus.com
BACKEND_URL: http://127.0.0.1:8080
BACKEND_HEALTH_URL: http://127.0.0.1:8001
BACKEND_API_KEY: replace-with-backend-api-key
AI_SERVICE_API_KEY: replace-with-backend-api-key

DATABASE_URL: postgresql://USER:PASSWORD@HOST-pooler/qurieus?sslmode=require
DIRECT_DATABASE_URL: postgresql://USER:PASSWORD@HOST/qurieus?sslmode=require

GOOGLE_CLIENT_ID: ""
GOOGLE_CLIENT_SECRET: ""

SMTP_HOST: smtp.gmail.com
SMTP_PORT: "587"
SMTP_USERNAME: ""
SMTP_PASSWORD: ""
SMTP_SECURE: "false"
SMTP_FROM_EMAIL: no-reply@qurieus.com
ADMIN_EMAIL: hello@qurieus.com

PADDLE_API_KEY: ""
PADDLE_WEBHOOK_SIGNING_KEY: ""
PADDLE_SOURCE_APP: quries
PADDLE_PRODUCT_TAG: quries

QDRANT_URL: ""
QDRANT_COLLECTION: qurieus
QDRANT_API_KEY: ""

MODAL_QUERY_DOCUMENTS_URL: ""
MODAL_DOT_COM_X_API_KEY: ""
MODAL_HEALTH_CHECK_URL: ""
MODAL_KEEP_WARM_URL: ""

AWS_REGION: ap-south-1
AWS_ACCESS_KEY_ID: ""
AWS_SECRET_ACCESS_KEY: ""
AWS_S3_BUCKET: qurieus

FAST_API_HOST: 127.0.0.1
FAST_API_PORT: "8001"
OCR_ENABLED: "True"
OCR_LANGUAGE: eng+hin
OCR_DPI: "300"
OCR_CONFIG: "--oem 3 --psm 6"
UPLOAD_DIR: uploaded_docs
OLLAMA_API_URL: ""
OLLAMA_MODEL: ""

PUPPETEER_EXECUTABLE_PATH: /usr/bin/chromium
ENABLE_AGENT_ESCALATION: "true"
